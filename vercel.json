{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/plan/:slug",
      "destination": "/api/plan?slug=:slug"
    },
    {
      "source": "/credit-card-calculator",
      "destination": "/credit-card-calculator.html"
    },
    {
      "source": "/agents/legacy-capital-program-calculator",
      "destination": "/agents/legacy-capital-program-calculator.html"
    },
    {
      "source": "/agents/commission-simulator",
      "destination": "https://funding-tier-profit-engine.vercel.app/commission-simulator"
    },
    {
      "source": "/agents/commission-simulator/:path*",
      "destination": "https://funding-tier-profit-engine.vercel.app/commission-simulator/:path*"
    },
    {
      "source": "/admins/legacy-capital-billable-payout-simulator",
      "destination": "/admins/legacy-capital-billable-payout-simulator.html"
    },
    {
      "source": "/admins/profit-engine",
      "destination": "https://funding-tier-profit-engine.vercel.app/profit-engine"
    },
    {
      "source": "/admins/profit-engine/:path*",
      "destination": "https://funding-tier-profit-engine.vercel.app/profit-engine/:path*"
    },
    {
      "source": "/profit-engine",
      "destination": "https://funding-tier-profit-engine.vercel.app/profit-engine"
    },
    {
      "source": "/profit-engine/:path*",
      "destination": "https://funding-tier-profit-engine.vercel.app/profit-engine/:path*"
    },
    {
      "source": "/iblusend",
      "destination": "https://iblusend-hub.vercel.app/"
    },
    {
      "source": "/iblusend/:path*",
      "destination": "https://iblusend-hub.vercel.app/:path*"
    },
    {
      "source": "/vendors/lead-vendor-guidelines/warm-call-transfers",
      "destination": "https://funding-tier-vendors.vercel.app/vendors/lead-vendor-guidelines/warm-call-transfers/"
    },
    {
      "source": "/vendors/lead-vendor-guidelines/warm-call-transfers/",
      "destination": "https://funding-tier-vendors.vercel.app/vendors/lead-vendor-guidelines/warm-call-transfers/"
    },
    {
      "source": "/vendors/lead-vendor-guidelines/warm-call-transfers/:path*",
      "destination": "https://funding-tier-vendors.vercel.app/vendors/lead-vendor-guidelines/warm-call-transfers/:path*"
    }
  ]
}
