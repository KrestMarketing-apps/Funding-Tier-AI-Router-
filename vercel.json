{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/generate-plan.js": {
      "maxDuration": 45
    }
  },
  "rewrites": [
    {
      "source": "/plan/:name/:token",
      "destination": "/api/plan?token=:token"
    },
    {
      "source": "/plan/:token",
      "destination": "/api/plan?token=:token"
    },
    {
      "source": "/agents/call-scripts",
      "destination": "/agents/call-scripts/index.html"
    },
    {
      "source": "/credit-card-calculator",
      "destination": "/credit-card-calculator.html"
    },
    {
      "source": "/agents/legacy-capital-program-calculator",
      "destination": "/agents/legacy-capital-program-calculator.html"
    },
    {
      "source": "/admins/legacy-capital-billable-payout-simulator",
      "destination": "/admins/legacy-capital-billable-payout-simulator.html"
    },
    {
      "source": "/admins/Backend-Payout-Process",
      "destination": "/admins/backend-payout-timing.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cleanup-plans",
      "schedule": "0 9 * * 1"
    }
  ]
}
